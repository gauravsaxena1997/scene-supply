{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "mediaType": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "audio",
        "component",
        "sequence",
        "text"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "durationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "width": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "height": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "provenance": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "providerId": {
          "type": "string"
        },
        "sidecarPath": {
          "type": "string",
          "minLength": 1
        },
        "rightsStatus": {
          "type": "string",
          "enum": [
            "review-required",
            "reviewed",
            "user-provided"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provider",
        "rightsStatus",
        "notes"
      ],
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "properties": {
        "exportName": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "props": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "registryReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "tailark",
                  "eldora",
                  "cult",
                  "kokonut",
                  "magicui"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "referencePath": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source",
              "name",
              "referencePath"
            ],
            "additionalProperties": false
          }
        },
        "frameDriven": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "exportName",
        "props",
        "dependencies",
        "registryReferences",
        "frameDriven"
      ],
      "additionalProperties": false
    },
    "sequenceAtomIds": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
      }
    }
  },
  "required": [
    "path",
    "mediaType",
    "provenance"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
