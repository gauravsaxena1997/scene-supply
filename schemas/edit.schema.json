{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "width": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "height": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "fps": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 120
    },
    "audio": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
          },
          "atomId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
          },
          "role": {
            "type": "string",
            "enum": [
              "narration",
              "music",
              "sfx",
              "ambience"
            ]
          },
          "startFrame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endFrame": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "sourceInSeconds": {
            "default": 0,
            "type": "number",
            "minimum": 0
          },
          "gain": {
            "default": 1,
            "type": "number",
            "minimum": 0,
            "maximum": 2
          }
        },
        "required": [
          "id",
          "atomId",
          "role",
          "startFrame",
          "endFrame",
          "sourceInSeconds",
          "gain"
        ],
        "additionalProperties": false
      }
    },
    "actions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
          },
          "shotId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
          },
          "frame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "enum": [
              "tap",
              "type",
              "reveal",
              "confirm",
              "hold",
              "custom"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "speechAnchor": {
            "type": "object",
            "properties": {
              "sentenceId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
              },
              "wordIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "edge": {
                "default": "start",
                "type": "string",
                "enum": [
                  "start",
                  "end"
                ]
              },
              "offsetFrames": {
                "default": 0,
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "sentenceId",
              "wordIndex",
              "edge",
              "offsetFrames"
            ],
            "additionalProperties": false
          },
          "audioCueId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
          }
        },
        "required": [
          "id",
          "shotId",
          "frame",
          "kind",
          "target"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "width",
    "height",
    "fps",
    "audio",
    "actions"
  ],
  "additionalProperties": false
}
